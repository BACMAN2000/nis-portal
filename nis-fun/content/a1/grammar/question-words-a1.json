    {
      "type": "steps",
      "title": "How to make a question with a question word",
      "steps": [
        {
          "label": "Start with the question word",
          "ex": "<b>Where</b>"
        },
        {
          "label": "Add the helper verb (be, do, does)",
          "ex": "Where <b>do</b> you"
        },
        {
          "label": "Add the rest and the verb",
          "ex": "Where do you <b>live</b>?"
        }
      ],
      "caption": "The question word always comes first. Nothing ever goes in front of it."
    }
  ],
