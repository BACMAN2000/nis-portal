  "use": [
    {
      "point": "What, Where and Who — things, places and people",
      "examples": [
        {
          "text": "<b>What's</b> your favourite subject?",
          "note": "What + is (What's) for a thing"
        },
        {
          "text": "<b>Where</b> do you live?",
          "note": "Where + do + you for a place"
        },
        {
          "text": "<b>Who</b> is your best friend?",
          "note": "Who + is for a person"
        }
      ]
    },
    {
      "point": "When and Why — time and reasons",
      "examples": [
        {
          "text": "<b>When</b> is your English exam?",
          "note": "When + is + noun for time"
        },
        {
          "text": "<b>Why</b> are you late?",
          "note": "Why + are + you for a reason"
        },
        {
          "text": "<b>Why</b> do you like tennis? — Because it's fun.",
          "note": "why...? — because... is the usual answer"
        }
      ]
    },
    {
      "point": "How — health, manner, age and quantity",
      "examples": [
        {
          "text": "<b>How</b> are you today?",
          "note": "asking how somebody feels"
        },
        {
          "text": "<b>How old</b> is your sister?",
          "note": "how + old for age"
        },
        {
          "text": "<b>How many</b> brothers and sisters have you got?",
          "note": "how many + plural noun, for things you can count"
        },
        {
          "text": "<b>How much</b> is this T-shirt?",
          "note": "how much, for prices and things you can't count"
        }
      ]
    },
    {
      "point": "Which — and the classic questions of Speaking Part 1",
      "examples": [
        {
          "text": "<b>Which</b> colour do you like, blue or green?",
          "note": "which, for choosing between options"
        },
        {
          "text": "<b>What do you do</b> at the weekend?",
          "note": "a classic Speaking Part 1 question"
        }
      ]
    }
  ],
  "watch_out": [
    {
      "wrong": "Where you live?",
      "right": "<b>Where do you live</b>?",
      "why": "A normal verb needs the helper do/does before the person. You can't skip it."
    },
    {
      "wrong": "What means this word?",
      "right": "What <b>does</b> this word <b>mean</b>?",
      "why": "With a normal verb you need does/do; the main verb doesn't move to the front."
    },
    {
      "wrong": "How many money have you got?",
      "right": "<b>How much</b> money have you got?",
      "why": "Money can't be counted one by one, so use how much, not how many."
    },
    {
      "wrong": "What's your name is?",
      "right": "<b>What's</b> your name?",
      "why": "Don't repeat the verb — What's already means What is."
    },
    {
      "wrong": "How old you are?",
      "right": "<b>How old are you</b>?",
      "why": "In a question, the verb be jumps in front of the person, straight after the question word."
    },
    {
      "wrong": "Why you don't like fish?",
      "right": "<b>Why don't you</b> like fish?",
      "why": "Don't stays with you, in the normal question order — question word, don't, you, verb."
    }
  ],
  "l1": [
    {
      "es": "¿Cómo te llamas?",
      "wrong": "How you call?",
      "right": "<b>What's your name</b>?",
      "why": "English doesn't ask 'how do you call yourself' — it asks for your name directly."
    },
    {
      "es": "¿Cuántos años tienes?",
      "wrong": "How many years do you have?",
      "right": "<b>How old are you</b>?",
      "why": "Age uses How old + be, not how many years + have."
    },
    {
      "es": "¿De dónde eres?",
      "wrong": "From where are you?",
      "right": "<b>Where are you from</b>?",
      "why": "In English, the small word from goes at the end of the question, not the start."
    },
    {
      "es": "¿Por qué no vienes?",
      "wrong": "Why not you come?",
      "right": "<b>Why don't you come</b>?",
      "why": "The negative don't stays next to you, in the normal question order."
    },
    {
      "es": "¿Cómo es tu casa?",
      "wrong": "How is your house?",
      "right": "<b>What's your house like</b>?",
      "why": "To describe something, ask What...like?. How...? asks about health or feelings, not appearance."
    }
  ],
  "remember": {
    "trick": "Question word → helper → you. Never swap the order!",
    "tip": "Say it three times fast: Where do you...? Where do you...? Where do you...? Now you won't forget the order."
  },
  "dialogue": {
    "title": "The video call interview",
    "context": "Sofia is doing a school project. She calls Liam on a video call and asks him questions for the interview.",
    "lines": [
      {
        "speaker": "Sofia",
        "text": "Hi Liam! Can I ask you some questions for my project? <b>Where</b> do you live?"
      },
      {
        "speaker": "Liam",
        "text": "I live in Trujillo, near the beach."
      },
      {
        "speaker": "Sofia",
        "text": "Nice! <b>What's</b> your favourite subject at school?"
      },
      {
        "speaker": "Liam",
        "text": "Science, definitely. <b>Why</b> do you ask?"
      },
      {
        "speaker": "Sofia",
        "text": "It's for my project! <b>How old</b> is your little sister?"
      },
      {
        "speaker": "Liam",
        "text": "She's seven. <b>Who</b> is in your project group?"
      },
      {
        "speaker": "Sofia",
        "text": "Mateo and Nadia. <b>How many</b> questions have I got left?"
      },
      {
        "speaker": "Liam",
        "text": "Just one more!"
      },
      {
        "speaker": "Sofia",
        "text": "OK — <b>when</b> is your birthday?"
      },
      {
        "speaker": "Liam",
        "text": "In October. Thanks for the interview, Sofia!"
      }
    ]
  },
