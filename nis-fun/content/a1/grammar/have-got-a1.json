    {
      "type": "steps",
      "title": "How to make a question with have got",
      "steps": [
        {
          "label": "Start with have or has",
          "ex": "<b>Have</b>"
        },
        {
          "label": "Add the person",
          "ex": "Have <b>you</b>"
        },
        {
          "label": "Add got and the thing",
          "ex": "Have you <b>got</b> a dog"
        },
        {
          "label": "Add the question mark",
          "ex": "Have you got a dog<b>?</b>"
        }
      ],
      "caption": "No <i>do</i> is needed with have got. It makes its own questions by moving to the front, just like be."
    }
  ],
