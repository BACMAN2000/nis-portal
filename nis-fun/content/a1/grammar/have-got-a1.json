  "use": [
    {
      "point": "Family and pets",
      "examples": [
        {
          "text": "I<b>'ve got</b> two sisters and a dog.",
          "note": "talking about family and pets"
        },
        {
          "text": "Sofia<b>'s got</b> a cat called Luna.",
          "note": "he/she/it → 's got"
        },
        {
          "text": "We<b>'ve got</b> a new puppy at home.",
          "note": "we → 've got"
        }
      ]
    },
    {
      "point": "Describing people: hair, eyes, things",
      "examples": [
        {
          "text": "Nadia<b>'s got</b> long dark hair.",
          "note": "describing appearance with 's got"
        },
        {
          "text": "He<b>'s got</b> brown eyes and a big smile.",
          "note": "two things with one 's got"
        },
        {
          "text": "You<b>'ve got</b> a new haircut!",
          "note": "you → 've got"
        }
      ]
    },
    {
      "point": "Negative: what you don't have",
      "examples": [
        {
          "text": "I <b>haven't got</b> a bike.",
          "note": "I → haven't got"
        },
        {
          "text": "Liam <b>hasn't got</b> a brother.",
          "note": "he/she/it → hasn't got"
        },
        {
          "text": "They <b>haven't got</b> any homework today.",
          "note": "they → haven't got"
        }
      ]
    },
    {
      "point": "Questions and short answers",
      "examples": [
        {
          "text": "<b>Have</b> you <b>got</b> a pet? — Yes, I have.",
          "note": "question + short answer"
        },
        {
          "text": "<b>Has</b> she <b>got</b> a phone? — No, she hasn't.",
          "note": "he/she/it → has in the question"
        },
        {
          "text": "<b>Have</b> they <b>got</b> a car? — Yes, they have.",
          "note": "they → have in the question"
        }
      ]
    }
  ],
  "watch_out": [
    {
      "wrong": "Do you have got a pet?",
      "right": "<b>Have</b> you <b>got</b> a pet?",
      "why": "Don't use do/does with have got — have or has moves to the front alone."
    },
    {
      "wrong": "She have got a cat.",
      "right": "She <b>has got</b> a cat.",
      "why": "He/she/it needs has got, not have got."
    },
    {
      "wrong": "I not got a bike.",
      "right": "I <b>haven't got</b> a bike.",
      "why": "The negative needs have/has + n't before got."
    },
    {
      "wrong": "Has you got a sister?",
      "right": "<b>Have</b> you got a sister?",
      "why": "You always takes have, even in questions."
    },
    {
      "wrong": "I've got hair brown.",
      "right": "I've got <b>brown hair</b>.",
      "why": "The adjective goes before the noun in English: brown hair, not hair brown."
    },
    {
      "wrong": "She's a dog.",
      "right": "She<b>'s got</b> a dog.",
      "why": "Here 's means has, not is — don't forget got."
    }
  ],
  "l1": [
    {
      "es": "Tengo el pelo largo.",
      "wrong": "I have the hair long.",
      "right": "I<b>'ve got</b> long hair.",
      "why": "No the with your own body parts, and the adjective (long) goes before the noun (hair)."
    },
    {
      "es": "Tengo doce años.",
      "wrong": "I've got twelve years.",
      "right": "I<b>'m</b> twelve.",
      "why": "Age uses be (am/is/are), not have got."
    },
    {
      "es": "Tengo hambre.",
      "wrong": "I've got hungry.",
      "right": "I<b>'m</b> hungry.",
      "why": "Feelings like hungry, cold and tired use be, not have got."
    },
    {
      "es": "¿Tienes un perro?",
      "wrong": "Do you have got a dog?",
      "right": "<b>Have</b> you <b>got</b> a dog?",
      "why": "Have got makes its own questions — it never needs do/does."
    },
    {
      "es": "Ella tiene un gato.",
      "wrong": "She have got a cat.",
      "right": "She <b>has got</b> a cat.",
      "why": "He/she/it changes have to has, even inside have got."
    }
  ],
  "remember": {
    "trick": "I/you/we/they HAVE got. He/she/it HAS got!",
    "tip": "Has is only for one person or thing — he, she or it. Everybody else says have. Say the chant three times."
  },
  "dialogue": {
    "title": "Saturday video call",
    "context": "Mateo, Sofia and Liam are on a video call on Saturday morning, showing each other their pets and new things.",
    "lines": [
      {
        "speaker": "Liam",
        "text": "Look! I<b>'ve got</b> a new puppy!"
      },
      {
        "speaker": "Mateo",
        "text": "Wow! <b>Has</b> he <b>got</b> a name?"
      },
      {
        "speaker": "Liam",
        "text": "Yes, he<b>'s got</b> a name — Rocky."
      },
      {
        "speaker": "Sofia",
        "text": "<b>Have</b> you <b>got</b> any other pets, Liam?"
      },
      {
        "speaker": "Liam",
        "text": "No, I <b>haven't got</b> any other pets."
      },
      {
        "speaker": "Mateo",
        "text": "I <b>haven't got</b> a dog, but I<b>'ve got</b> a goldfish."
      },
      {
        "speaker": "Sofia",
        "text": "My sister<b>'s got</b> a rabbit. It<b>'s got</b> really long ears!"
      },
      {
        "speaker": "Liam",
        "text": "<b>Has</b> the rabbit <b>got</b> a name too?"
      },
      {
        "speaker": "Sofia",
        "text": "Yes — Luna. She<b>'s got</b> white fur."
      }
    ]
  },
