  "use": [
    {
      "point": "Who you are: name, age, nationality, job",
      "examples": [
        {
          "text": "I<b>'m</b> Sofia and I<b>'m</b> twelve.",
          "note": "age uses be, not have"
        },
        {
          "text": "Mateo <b>is</b> from Arequipa. He<b>'s</b> Peruvian.",
          "note": "from + city, nationality adjective"
        },
        {
          "text": "Miss Vega <b>is</b> our English teacher.",
          "note": "a job or a role"
        },
        {
          "text": "Liam and Nadia <b>are</b> in my class.",
          "note": "two people → are"
        }
      ]
    },
    {
      "point": "Where you are",
      "examples": [
        {
          "text": "We<b>'re</b> at school now.",
          "note": "at + a place"
        },
        {
          "text": "My mum <b>is</b> at work and my dad <b>is</b> at home.",
          "note": "one person → is"
        },
        {
          "text": "The books <b>are</b> on the table.",
          "note": "things in the plural → are"
        }
      ]
    },
    {
      "point": "How you feel and what things are like",
      "examples": [
        {
          "text": "I<b>'m</b> hungry! <b>Is</b> it lunchtime?",
          "note": "feelings: hungry, tired, happy, cold"
        },
        {
          "text": "This exercise <b>is</b> easy, but that one <b>is</b> difficult.",
          "note": "describing things"
        },
        {
          "text": "It<b>'s</b> hot today and the sky <b>is</b> blue.",
          "note": "weather always starts with it"
        }
      ]
    },
    {
      "point": "Questions and short answers",
      "examples": [
        {
          "text": "<b>Are</b> you ready? — Yes, I <b>am</b>. / No, I<b>'m</b> not.",
          "note": "short answer = person + be"
        },
        {
          "text": "<b>Is</b> Nadia here? — No, she <b>isn't</b>.",
          "note": "no short form in a positive short answer: Yes, she is"
        },
        {
          "text": "Where <b>are</b> you from? — I<b>'m</b> from Lima.",
          "note": "question word + be + person"
        }
      ]
    }
  ],
  "watch_out": [
    {
      "wrong": "I have twelve years.",
      "right": "I <b>am</b> twelve. / I<b>'m</b> twelve years old.",
      "why": "Age is a <i>be</i> sentence in English. <i>Years old</i> is optional, <i>am</i> is not."
    },
    {
      "wrong": "She very happy today.",
      "right": "She <b>is</b> very happy today.",
      "why": "English needs the verb. Spanish can hide it, English never does."
    },
    {
      "wrong": "You is my friend.",
      "right": "You <b>are</b> my friend.",
      "why": "<i>You</i> always takes <i>are</i> — even for one person."
    },
    {
      "wrong": "Is hot today.",
      "right": "<b>It</b> is hot today.",
      "why": "The weather needs the little word <i>it</i>. No sentence starts with <i>is</i> unless it's a question."
    },
    {
      "wrong": "Yes, I'm.",
      "right": "Yes, I <b>am</b>.",
      "why": "In a positive short answer, say the full form. Short forms only in negatives: <i>No, I'm not.</i>"
    },
    {
      "wrong": "Are from Peru you?",
      "right": "<b>Are you</b> from Peru?",
      "why": "In a question, <i>be</i> comes first and the person comes second. Nothing else moves."
    }
  ],
  "l1": [
    {
      "es": "Tengo doce años.",
      "wrong": "I have twelve years.",
      "right": "I <b>am</b> twelve.",
      "why": "In English, you <i>are</i> your age; you don't <i>have</i> it."
    },
    {
      "es": "Tengo hambre / frío / sueño.",
      "wrong": "I have hungry.",
      "right": "I <b>am</b> hungry / cold / sleepy.",
      "why": "Feelings like hungry, cold, hot and tired all use <i>be</i>."
    },
    {
      "es": "Es lunes. Hace calor.",
      "wrong": "Is Monday. Is hot.",
      "right": "<b>It's</b> Monday. <b>It's</b> hot.",
      "why": "English sentences need a subject. For days, time and weather, that subject is <i>it</i>."
    },
    {
      "es": "Soy de Lima.",
      "wrong": "I from Lima.",
      "right": "I<b>'m</b> from Lima.",
      "why": "Spanish can drop the person (<i>soy</i> already says it); English needs both the person and the verb."
    }
  ],
  "remember": {
    "trick": "I am · he/she/it is · everybody else ARE",
    "tip": "Only <i>I</i> gets <i>am</i>. Only one person or thing gets <i>is</i>. <i>You</i>, <i>we</i>, <i>they</i> and any group get <i>are</i>. Say it like a chant three times and you'll never forget it."
  },
  "dialogue": {
    "title": "New in class",
    "context": "Liam is new at Nordic. Sofia and Mateo meet him in the corridor before the first lesson.",
    "lines": [
      {
        "speaker": "Sofia",
        "text": "Hi! <b>Are</b> you new here?"
      },
      {
        "speaker": "Liam",
        "text": "Yes, I <b>am</b>. I<b>'m</b> Liam. I<b>'m</b> from Trujillo."
      },
      {
        "speaker": "Mateo",
        "text": "Nice to meet you! I<b>'m</b> Mateo and this <b>is</b> Sofia. We<b>'re</b> in your class."
      },
      {
        "speaker": "Liam",
        "text": "Great! <b>Is</b> the English teacher nice?"
      },
      {
        "speaker": "Sofia",
        "text": "Miss Vega? She<b>'s</b> fantastic. Her lessons <b>are</b> fun."
      },
      {
        "speaker": "Liam",
        "text": "How old <b>are</b> you two?"
      },
      {
        "speaker": "Mateo",
        "text": "I<b>'m</b> twelve and Sofia <b>is</b> eleven. Why?"
      },
      {
        "speaker": "Liam",
        "text": "I<b>'m</b> twelve too! <b>Are</b> we late? It<b>'s</b> eight o'clock."
      },
      {
        "speaker": "Sofia",
        "text": "No, we <b>aren't</b>. Look — Miss Vega <b>isn't</b> in the classroom yet."
      },
      {
        "speaker": "Mateo",
        "text": "Come on, Liam. Your seat <b>is</b> next to mine."
      }
    ]
  },
