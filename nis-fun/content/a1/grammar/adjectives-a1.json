        {"sentence": "What's your new bike ___?", "answers": ["like"]},
        {"sentence": "Nadia is ___ tired this morning.", "answers": ["really", "very"]},
        {"sentence": "My shoes are ___ (new).", "answers": ["new"]},
        {"sentence": "Liam has got ___ (brown) eyes.", "answers": ["brown"]},
        {"sentence": "I live in a ___ (small) house.", "answers": ["small"]}
