  "use": [
    {
      "point": "Routines and habits",
      "examples": [
        {
          "text": "I <b>get up</b> at seven o'clock.",
          "note": "a daily routine"
        },
        {
          "text": "We <b>walk</b> to school every day.",
          "note": "we = a group, no -s"
        },
        {
          "text": "They <b>do</b> their homework after school.",
          "note": "they = more than one person"
        }
      ]
    },
    {
      "point": "Likes, loves and hates + noun",
      "examples": [
        {
          "text": "I <b>love</b> pizza.",
          "note": "like/love/hate + noun, no to"
        },
        {
          "text": "You <b>like</b> football.",
          "note": "an opinion or a fact about you"
        },
        {
          "text": "We <b>hate</b> maths homework.",
          "note": "a strong dislike"
        }
      ]
    },
    {
      "point": "Negative with don't",
      "examples": [
        {
          "text": "I <b>don't like</b> spiders.",
          "note": "I → don't + base verb"
        },
        {
          "text": "We <b>don't watch</b> TV on school nights.",
          "note": "we → don't + base verb"
        },
        {
          "text": "They <b>don't play</b> video games at school.",
          "note": "they → don't + base verb"
        }
      ]
    },
    {
      "point": "Questions, short answers and everyday time words",
      "examples": [
        {
          "text": "<b>Do</b> you <b>play</b> a sport? — Yes, I do.",
          "note": "question + short answer"
        },
        {
          "text": "<b>Do</b> they <b>go</b> to bed early? — No, they don't.",
          "note": "they → do in the question"
        },
        {
          "text": "I read <b>every day</b> and I swim <b>at the weekend</b>.",
          "note": "everyday time words show how often"
        }
      ]
    }
  ],
  "watch_out": [
    {
      "wrong": "I no like fish.",
      "right": "I <b>don't like</b> fish.",
      "why": "The negative needs the helper don't, not just no."
    },
    {
      "wrong": "Do you plays football?",
      "right": "Do you <b>play</b> football?",
      "why": "After do/does, the verb goes back to its base form — no -s."
    },
    {
      "wrong": "I like play basketball.",
      "right": "I like <b>playing</b> basketball.",
      "why": "After like/love/hate, English uses -ing (or just a noun), not the base verb."
    },
    {
      "wrong": "Yes, I like.",
      "right": "Yes, I <b>do</b>.",
      "why": "Short answers repeat do/don't, not the main verb."
    },
    {
      "wrong": "We don't likes maths.",
      "right": "We <b>don't like</b> maths.",
      "why": "After don't, the verb never takes -s."
    },
    {
      "wrong": "Not I like spiders.",
      "right": "I <b>don't like</b> spiders.",
      "why": "Don't goes after the person, not before the whole sentence."
    }
  ],
  "l1": [
    {
      "es": "No me gusta el pescado.",
      "wrong": "I no like fish.",
      "right": "I <b>don't like</b> fish.",
      "why": "Spanish makes a negative with no + verb; English needs the helper verb don't."
    },
    {
      "es": "Me gusta jugar fútbol.",
      "wrong": "I like play football.",
      "right": "I like <b>playing</b> football.",
      "why": "After like, English uses -ing (or just the noun), not the base verb."
    },
    {
      "es": "¿Juegas fútbol?",
      "wrong": "Play you football?",
      "right": "<b>Do</b> you <b>play</b> football?",
      "why": "English questions need do/does — the verb doesn't move to the front on its own."
    },
    {
      "es": "Sí, me gusta.",
      "wrong": "Yes, I like.",
      "right": "Yes, I <b>do</b>.",
      "why": "Short answers repeat do/does, not the main verb like."
    },
    {
      "es": "Nosotros no vemos la tele.",
      "wrong": "We not watch TV.",
      "right": "We <b>don't watch</b> TV.",
      "why": "Not can't stand alone before a verb — it needs the helper don't with it."
    }
  ],
  "remember": {
    "trick": "DO helps I, you, we, they. DON'T for the negative!",
    "tip": "Do is the helper for questions and don't for negatives — the main verb never changes: play, not plays."
  },
  "dialogue": {
    "title": "Free time at the beach",
    "context": "Mateo, Nadia and Liam are on a school trip to a beach near Lima, talking about what they do every day.",
    "lines": [
      {
        "speaker": "Mateo",
        "text": "I <b>love</b> the beach! We <b>come</b> here every summer."
      },
      {
        "speaker": "Nadia",
        "text": "Really? I <b>don't like</b> swimming in the sea — too cold!"
      },
      {
        "speaker": "Liam",
        "text": "<b>Do</b> you <b>surf</b>, Mateo?"
      },
      {
        "speaker": "Mateo",
        "text": "No, I <b>don't</b>. I only <b>play</b> football on the sand."
      },
      {
        "speaker": "Nadia",
        "text": "We <b>play</b> volleyball at the weekend with my cousins."
      },
      {
        "speaker": "Liam",
        "text": "<b>Do</b> your cousins <b>live</b> near the beach?"
      },
      {
        "speaker": "Nadia",
        "text": "Yes, they <b>do</b>. They <b>walk</b> here every day!"
      },
      {
        "speaker": "Mateo",
        "text": "I <b>don't walk</b> to the beach — it's too far from my house."
      },
      {
        "speaker": "Liam",
        "text": "Let's <b>build</b> a sandcastle! I <b>love</b> that."
      },
      {
        "speaker": "Nadia",
        "text": "Good idea — we <b>don't have</b> much time left."
      }
    ]
  },
