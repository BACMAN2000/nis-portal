    {
      "es": "Él no come carne.",
      "wrong": "He don't eat meat.",
      "right": "He <b>doesn't eat</b> meat.",
      "why": "He/she/it needs doesn't (does + not), not don't."
    },
    {
      "es": "¿Estudia ella todos los días?",
      "wrong": "Does she studies every day?",
      "right": "Does she <b>study</b> every day?",
      "why": "Does already shows the question is about he/she/it, so the verb after it has no -s."
    },
    {
      "es": "Ella tiene un perro.",
      "wrong": "She haves a dog.",
      "right": "She <b>has</b> a dog.",
      "why": "Have is irregular in the he/she/it form: has, not haves."
    },
    {
      "es": "Mi papá trabaja mucho.",
      "wrong": "My dad work a lot.",
      "right": "My dad <b>works</b> a lot.",
      "why": "A name or \"my dad\" is also he/she/it, and needs the -s too."
    }
  ],
  "remember": {
    "trick": "HE, SHE, IT — don't forget the S on the verb!",
    "tip": "Every time you say he, she or it, listen for the little -s at the end of the verb. No -s in questions or negatives though — does and doesn't already carry it."
  },
