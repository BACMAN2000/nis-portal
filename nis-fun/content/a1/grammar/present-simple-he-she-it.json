  "use": [
    {
      "point": "he, she, it: add -s",
      "examples": [
        {
          "text": "Liam <b>plays</b> the guitar.",
          "note": "most verbs: just add -s"
        },
        {
          "text": "Nadia <b>swims</b> every morning.",
          "note": "he/she/it → -s"
        },
        {
          "text": "It <b>rains</b> a lot in the mountains.",
          "note": "it (the weather) → -s too"
        }
      ]
    },
    {
      "point": "Spelling: -es and -ies",
      "examples": [
        {
          "text": "Mateo <b>watches</b> cartoons on Saturday.",
          "note": "-ch → add -es"
        },
        {
          "text": "Sofia <b>goes</b> to bed at nine.",
          "note": "-o → add -es"
        },
        {
          "text": "She <b>studies</b> every evening.",
          "note": "consonant + y → ies"
        },
        {
          "text": "Miss Vega <b>has</b> three classes today.",
          "note": "have is irregular → has"
        }
      ]
    },
    {
      "point": "Negative with doesn't",
      "examples": [
        {
          "text": "He <b>doesn't like</b> broccoli.",
          "note": "he → doesn't + base verb"
        },
        {
          "text": "Nadia <b>doesn't play</b> video games.",
          "note": "she → doesn't + base verb"
        },
        {
          "text": "It <b>doesn't rain</b> much here.",
          "note": "it → doesn't + base verb"
        }
      ]
    },
    {
      "point": "Questions and short answers",
      "examples": [
        {
          "text": "<b>Does</b> she <b>train</b> every day? — Yes, she does.",
          "note": "question + short answer"
        },
        {
          "text": "<b>Does</b> he <b>live</b> near school? — No, he doesn't.",
          "note": "he → does in the question"
        },
        {
          "text": "<b>Does</b> it <b>bite</b>? — No, it doesn't.",
          "note": "it → does in the question"
        }
      ]
    }
  ],
  "watch_out": [
    {
      "wrong": "She play tennis.",
      "right": "She <b>plays</b> tennis.",
      "why": "He/she/it needs the extra -s in a statement."
    },
    {
      "wrong": "He don't like fish.",
      "right": "He <b>doesn't like</b> fish.",
      "why": "He/she/it needs doesn't, not don't."
    },
    {
      "wrong": "She doesn't likes fish.",
      "right": "She <b>doesn't like</b> fish.",
      "why": "After doesn't, the verb goes back to its base form — no -s."
    },
    {
      "wrong": "Does she plays tennis?",
      "right": "Does she <b>play</b> tennis?",
      "why": "After does, the verb loses its -s too."
    },
    {
      "wrong": "She go to bed early.",
      "right": "She <b>goes</b> to bed early.",
      "why": "Verbs ending in -o add -es, not just -s."
    },
    {
      "wrong": "Miss Vega haves a car.",
      "right": "Miss Vega <b>has</b> a car.",
      "why": "Have is irregular — the he/she/it form is has, not haves."
    }
  ],
  "l1": [
    {
      "es": "Ella juega fútbol.",
      "wrong": "She play football.",
      "right": "She <b>plays</b> football.",
      "why": "Spanish verbs for he/she/it don't need an extra letter — English adds -s."
