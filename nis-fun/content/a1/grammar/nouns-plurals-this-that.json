      "caption": "<b>A</b> and <b>an</b> depend on the sound. Add <b>-s</b> for more than one. <b>This/that/these/those</b> point at things."
    },
    {
      "type": "spelling",
      "title": "Making nouns plural",
      "rules": [
        {
          "rule": "Most nouns: + s",
          "examples": [
            "dog → dog<b>s</b>",
            "pen → pen<b>s</b>",
            "book → book<b>s</b>"
          ]
        },
        {
          "rule": "-s, -sh, -ch, -x, -o: + es",
          "examples": [
            "bus → bus<b>es</b>",
            "watch → watch<b>es</b>",
            "box → box<b>es</b>"
          ]
        },
        {
          "rule": "consonant + y: y → ies",
          "examples": [
            "baby → bab<b>ies</b>",
            "city → cit<b>ies</b>"
          ]
        },
        {
          "rule": "Some nouns are irregular — no rule!",
          "examples": [
            "child → <b>children</b>",
            "person → <b>people</b>",
            "foot → <b>feet</b>",
            "mouse → <b>mice</b>"
          ]
        }
      ],
      "caption": "Say the word out loud — your ears usually know which ending sounds right."
    },
    {
      "type": "contrast",
      "title": "this, that, these, those",
      "columns": [
        "One thing (singular)",
        "More than one (plural)"
      ],
      "rows": [
        {
          "label": "Near (close to you)",
          "cells": [
            "this",
