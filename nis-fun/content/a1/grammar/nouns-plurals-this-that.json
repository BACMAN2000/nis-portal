  "form": {
    "formula": [
      {
        "chip": "a / an",
        "tone": "kw",
        "ex": "a dog / an apple"
      },
      {
        "chip": "noun (+ -s/-es/-ies)",
        "tone": "a",
        "ex": "dogs / boxes / babies"
      },
      {
        "chip": "this / that / these / those",
        "tone": "b",
        "ex": "this dog / those apples"
      }
    ],
    "table": {
      "head": [
        "",
        "Singular",
        "Plural"
      ],
      "rows": [
        [
          "Near",
          "this",
          "these"
        ],
        [
          "Far",
          "that",
          "those"
        ]
      ]
    }
  },
  "use": [
    {
      "point": "a or an: listen to the sound",
      "examples": [
        {
          "text": "I've got <b>a</b> dog and <b>a</b> cat.",
          "note": "dog, cat start with a consonant sound"
        },
        {
          "text": "She's got <b>an</b> apple and <b>an</b> orange.",
          "note": "apple, orange start with a vowel sound"
        },
        {
          "text": "He's wearing <b>a</b> uniform.",
          "note": "uniform sounds like \"yu-niform\" — a consonant sound"
        }
      ]
    },
    {
      "point": "One noun, more than one noun (plurals)",
      "examples": [
        {
          "text": "I've got two <b>dogs</b> and three <b>cats</b>.",
          "note": "most nouns: just add -s"
        },
        {
          "text": "There are five <b>buses</b> outside the school.",
          "note": "-s, -sh, -ch, -x, -o nouns add -es"
        },
        {
          "text": "She's got three <b>babies</b> in her family.",
          "note": "consonant + y → change y to ies"
        },
        {
          "text": "The <b>children</b> are playing in the garden.",
          "note": "irregular plural — no -s at all"
        }
      ]
    },
    {
      "point": "this / that: one thing",
      "examples": [
        {
          "text": "<b>This</b> is my pen. It's in my hand.",
          "note": "this = one thing, near you"
        },
        {
          "text": "<b>That</b> is your bag. It's over there.",
          "note": "that = one thing, far from you"
        },
        {
          "text": "What's <b>this</b>? — It's a map of Peru.",
          "note": "question with this + a singular answer"
        }
      ]
    },
    {
      "point": "these / those: more than one thing",
      "examples": [
        {
          "text": "<b>These</b> are my books. They're here.",
          "note": "these = more than one, near you"
        },
        {
          "text": "<b>Those</b> are your shoes. They're over there.",
          "note": "those = more than one, far away"
        },
        {
          "text": "What are <b>those</b>? — They're alpacas!",
          "note": "question with those + a plural answer"
        }
      ]
    }
  ],
  "watch_out": [
    {
      "wrong": "I have got a apple.",
      "right": "I have got <b>an</b> apple.",
      "why": "Apple starts with a vowel sound, so it needs an, not a."
    },
    {
      "wrong": "I have got an university.",
      "right": "I have got <b>a</b> university.",
      "why": "University starts with a y sound, like \"you\" — a consonant sound, so it needs a."
    },
    {
      "wrong": "Two childs are in my class.",
      "right": "Two <b>children</b> are in my class.",
      "why": "Child is irregular: the plural is children, never childs."
    },
    {
      "wrong": "This are my friends.",
      "right": "<b>These</b> are my friends.",
      "why": "This is singular. For more than one person or thing, use these."
    },
    {
      "wrong": "I've got two watch.",
      "right": "I've got two <b>watches</b>.",
      "why": "Watch ends in -ch, so the plural adds -es: watches."
    },
    {
      "wrong": "That is my books.",
      "right": "<b>Those</b> are my books.",
      "why": "Books is plural, so you need those + are, not that + is."
    }
  ],
  "l1": [
    {
      "es": "Tengo una manzana.",
      "wrong": "I have a apple.",
      "right": "I have <b>an</b> apple.",
      "why": "Before a vowel sound English uses an — Spanish un/una doesn't change like this."
    },
    {
      "es": "Los niños están en el parque.",
      "wrong": "The childs are in the park.",
      "right": "The <b>children</b> are in the park.",
      "why": "Spanish adds -s to everything; English has a few irregular plurals with no -s."
    },
    {
      "es": "Estos son mis amigos.",
      "wrong": "This are my friends.",
      "right": "<b>These</b> are my friends.",
      "why": "This/that only work with one thing. For more than one, use these/those."
    },
    {
      "es": "Es una casa grande.",
      "wrong": "It's one house.",
      "right": "It's <b>a</b> house.",
      "why": "Spanish un/una means both a and one; English keeps the two words separate."
    },
    {
      "es": "Tengo dos cajas.",
      "wrong": "I have two box.",
      "right": "I have two <b>boxes</b>.",
      "why": "Words ending in -x, -s, -sh or -ch add -es, not just -s."
    }
  ],
  "remember": {
    "trick": "Listen to the SOUND: a dog, an apple, a university!",
    "tip": "Say the word out loud. If it starts with a vowel sound (a, e, i, o, u), use an. If not, use a — even when the letter looks different, like in a university or an hour."
  },
  "dialogue": {
    "title": "At the market in Cusco",
    "context": "Mateo, Sofia and Nadia are at the craft market in Cusco, choosing souvenirs for their families.",
    "lines": [
      {
        "speaker": "Mateo",
        "text": "Look at <b>this</b> hat! It's for my dad."
      },
      {
        "speaker": "Sofia",
        "text": "Nice! Is it <b>a</b> or <b>an</b> alpaca hat?"
      },
      {
        "speaker": "Mateo",
        "text": "It's <b>an</b> alpaca hat — look at the wool."
      },
      {
        "speaker": "Nadia",
        "text": "I want <b>these</b> two bracelets for my sisters."
      },
      {
        "speaker": "Sofia",
        "text": "And what about <b>those</b> bags over there?"
      },
      {
        "speaker": "Mateo",
        "text": "<b>That</b> one is nice, but it's expensive."
      },
      {
        "speaker": "Nadia",
        "text": "I need <b>a</b> small bag, not <b>a</b> big one."
      },
      {
        "speaker": "Sofia",
        "text": "Look — <b>children</b>'s toys! Llamas and alpacas."
      },
      {
        "speaker": "Mateo",
        "text": "Let's buy three <b>llamas</b> — one for each of us!"
      },
      {
        "speaker": "Nadia",
        "text": "Good idea! <b>This</b> market has everything."
      }
    ]
  },
