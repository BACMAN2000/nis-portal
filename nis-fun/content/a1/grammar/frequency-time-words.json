  "use": [
    {
      "point": "Frequency words: before the main verb",
      "examples": [
        {
          "text": "I <b>always</b> brush my teeth.",
          "note": "100% of the time"
        },
        {
          "text": "We <b>usually</b> walk to school.",
          "note": "most of the time"
        },
        {
          "text": "They <b>sometimes</b> play video games.",
          "note": "not every time"
        },
        {
          "text": "He <b>never</b> eats vegetables.",
          "note": "0% of the time"
        }
      ]
    },
    {
      "point": "Frequency words: after be",
      "examples": [
        {
          "text": "She <b>is</b> always <b>happy</b> on Fridays.",
          "note": "frequency word after be"
        },
        {
          "text": "We <b>are</b> never <b>late</b> for school.",
          "note": "frequency word after be"
        },
        {
          "text": "I<b>'m</b> usually tired on Mondays.",
          "note": "frequency word after be"
        }
      ]
    },
    {
      "point": "How often…? and frequency phrases",
