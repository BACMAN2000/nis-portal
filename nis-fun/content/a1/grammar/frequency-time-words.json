  "watch_out": [
    {
      "wrong": "I play always football.",
      "right": "I <b>always</b> play football.",
      "why": "The frequency word goes before the main verb, not after."
    },
    {
      "wrong": "She never is late.",
      "right": "She <b>is never</b> late.",
      "why": "With be, the frequency word goes after it, not before."
    },
    {
      "wrong": "I go sometimes to the market.",
      "right": "I <b>sometimes</b> go to the market.",
      "why": "Sometimes goes before the main verb."
    },
    {
      "wrong": "We have class in Monday.",
      "right": "We have class <b>on</b> Monday.",
      "why": "Days of the week use on, not in."
    },
    {
      "wrong": "My birthday is on July.",
      "right": "My birthday is <b>in</b> July.",
      "why": "Months use in, not on."
    },
    {
      "wrong": "How much often do you play?",
      "right": "<b>How often</b> do you play?",
      "why": "The fixed question phrase is How often, not a word-for-word translation."
    }
  ],
  "l1": [
    {
      "es": "Siempre juego fútbol los sábados.",
      "wrong": "I play always football on Saturdays.",
      "right": "I <b>always</b> play football on Saturdays.",
      "why": "Spanish siempre can go after the verb; English always goes before the main verb."
    },
    {
      "es": "Nunca está tarde.",
      "wrong": "She never is late.",
      "right": "She <b>is never</b> late.",
      "why": "With the verb be, the frequency word goes after it, not before."
    },
    {
      "es": "Tenemos clase el lunes.",
      "wrong": "We have class in Monday.",
      "right": "We have class <b>on</b> Monday.",
      "why": "Spanish uses el for days; English uses on, not in."
    },
    {
      "es": "Mi cumpleaños es en julio.",
      "wrong": "My birthday is on July.",
      "right": "My birthday is <b>in</b> July.",
      "why": "Spanish en covers both days and months; English splits them into on (days) and in (months)."
    },
    {
      "es": "¿Qué tan seguido…?",
      "wrong": "How much often do you play?",
      "right": "<b>How often</b> do you play?",
      "why": "The fixed question phrase is How often, not a word-for-word translation."
    }
  ],
  "remember": {
    "trick": "Before the verb, after BE!",
    "tip": "Frequency words like always, usually, sometimes and never go before the main verb, but after am/is/are: I always play, but I am never late."
  },
  "dialogue": {
    "title": "A day in the life",
    "context": "Mateo, Liam and Nadia are having lunch at school on Wednesday, talking about their weekly activities.",
    "lines": [
      {
        "speaker": "Mateo",
        "text": "I <b>always</b> have football practice on Wednesdays."
      },
      {
        "speaker": "Liam",
        "text": "Really? I <b>never</b> play sport on Wednesdays — I have guitar lessons."
      },
      {
        "speaker": "Nadia",
        "text": "<b>How often</b> do you practise the guitar?"
      },
      {
        "speaker": "Liam",
        "text": "<b>Twice a week</b> — on Mondays and Wednesdays."
      },
      {
        "speaker": "Mateo",
        "text": "I <b>usually</b> do my homework <b>at</b> six o'clock."
      },
      {
        "speaker": "Nadia",
        "text": "I<b>'m</b> usually busy <b>at</b> the weekend with my cousins."
      },
      {
        "speaker": "Liam",
        "text": "Are you <b>ever</b> free <b>on</b> Saturdays?"
      },
      {
        "speaker": "Nadia",
        "text": "<b>Sometimes</b> — not every Saturday."
      },
      {
        "speaker": "Mateo",
        "text": "My birthday is <b>in</b> October. Let's plan something!"
      },
      {
        "speaker": "Liam",
        "text": "Good idea — I<b>'m</b> <b>never</b> busy <b>in</b> October."
      }
    ]
  },
