  "can_do": [
    "I can say what is happening right now using <i>am/is/are + -ing</i>.",
    "I can spell the -ing form correctly (sit → sitting, make → making, study → studying).",
    "I can ask and answer <i>What are you doing?</i> and <i>Is she…ing?</i>"
  ],
  "summary": [
    "Present continuous = <b>am/is/are + verb-ing</b>, for right now.",
    "Signal words: <i>look!, listen!, now, at the moment, today</i>.",
    "Watch the spelling: <i>sit → sitting, make → making, study → studying</i>.",
    "Question: <i>am/is/are</i> jumps to the front — <i>Is she…ing? What are you doing?</i>",
    "State verbs like <i>like, want, know</i> don't usually take -ing."
  ]
}
