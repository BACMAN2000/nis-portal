        }
      ],
      "caption": "<b>am/is/are</b> + verb-<b>ing</b>. The helper be moves to the front to make a question."
    },
    {
      "type": "map",
      "title": "Words that signal present continuous",
      "center": "happening now",
      "branches": [
        {
          "label": "now",
          "items": [
            "I'm eating now."
          ],
          "tone": "a"
        },
        {
          "label": "Look! / Listen!",
          "items": [
            "Look! She's dancing.",
            "Listen! They're singing."
          ],
          "tone": "b"
        },
        {
          "label": "at the moment",
          "items": [
            "He's studying at the moment."
          ],
          "tone": "c"
        },
        {
          "label": "today",
          "items": [
            "It's raining today."
          ],
          "tone": "a"
        }
      ]
    },
    {
      "type": "spelling",
      "title": "Spelling the -ing form",
      "rules": [
        {
          "rule": "Most verbs: + ing",
          "examples": [
            "eat → eat<b>ing</b>",
            "climb → climb<b>ing</b>"
          ]
        },
        {
          "rule": "one vowel + one consonant: double the consonant",
          "examples": [
            "sit → sit<b>ting</b>",
            "run → run<b>ning</b>"
          ]
        },
        {
          "rule": "verb ending in -e: drop the e + ing",
          "examples": [
            "take → tak<b>ing</b>",
            "make → mak<b>ing</b>"
          ]
        },
        {
          "rule": "verb ending in -ie: change to -y + ing",
          "examples": [
            "lie → ly<b>ing</b>",
            "die → dy<b>ing</b>"
          ]
        }
      ],
      "caption": "Say the word out loud — if the vowel sounds short, double the last letter."
    }
  ],
  "form": {
    "formula": [
      {
        "chip": "person",
        "tone": "a",
        "ex": "I / she / they"
      },
      {
        "chip": "am / is / are (+ not)",
        "tone": "kw",
        "ex": "is / isn't"
      },
      {
        "chip": "verb-ing",
        "tone": "b",
        "ex": "climbing"
      },
      {
        "chip": "the rest",
        "tone": "c",
        "ex": "the steps"
      }
    ],
    "table": {
      "head": [
        "Person",
        "Statement",
        "Negative",
        "Question"
      ],
      "rows": [
        [
          "I",
          "I'm climbing.",
          "I'm not climbing.",
          "Am I climbing?"
        ],
        [
          "you",
          "You're climbing.",
          "You aren't climbing.",
          "Are you climbing?"
        ],
        [
          "he / she / it",
          "She's climbing.",
          "She isn't climbing.",
          "Is she climbing?"
        ],
        [
          "we",
          "We're climbing.",
          "We aren't climbing.",
          "Are we climbing?"
        ],
        [
          "they",
          "They're climbing.",
          "They aren't climbing.",
          "Are they climbing?"
        ]
      ]
    }
  },
  "use": [
    {
      "point": "Right now, at this exact moment",
      "examples": [
        {
          "text": "<b>Look!</b> Mateo <b>is climbing</b> the steps.",
          "note": "look! + is + verb-ing, happening right now"
        },
        {
          "text": "<b>Listen!</b> Someone <b>is singing</b> in the square.",
          "note": "listen! for a sound happening now"
        },
        {
          "text": "I<b>'m writing</b> a postcard <b>at the moment</b>.",
          "note": "at the moment = right now"
        }
      ]
    },
    {
      "point": "Around now — today, this week",
      "examples": [
        {
          "text": "We<b>'re staying</b> in a small hotel this week.",
          "note": "a longer action, still not finished"
        },
        {
          "text": "It<b>'s raining</b> today, so we<b>'re wearing</b> jackets.",
          "note": "today = a temporary situation"
        }
      ]
    },
    {
      "point": "Negatives and questions",
      "examples": [
        {
          "text": "Liam <b>isn't eating</b> ice cream — he<b>'s eating</b> a sandwich.",
          "note": "isn't + verb-ing = negative"
        },
        {
          "text": "<b>Are</b> you <b>taking</b> photos too?",
          "note": "am/is/are jumps to the front"
        },
        {
          "text": "<b>Is</b> Sofia <b>having</b> a good time? — Yes, she <b>is</b>.",
          "note": "short answer = person + is/am/are"
        }
      ]
    },
    {
      "point": "The spelling of the -ing form",
      "examples": [
        {
          "text": "Nadia <b>is sitting</b> on the wall.",
          "note": "sit → sitting, double the t"
        },
        {
          "text": "Miss Vega <b>is making</b> a video.",
          "note": "make → making, drop the e"
        },
        {
          "text": "Everyone <b>is studying</b> the map.",
          "note": "study → studying, just add ing after y"
        }
      ]
    }
  ],
  "watch_out": [
    {
      "wrong": "She is study now.",
      "right": "She <b>is studying</b> now.",
      "why": "Don't forget the -ing ending on the verb."
    },
    {
      "wrong": "I am eat now.",
      "right": "I <b>am eating</b> now.",
      "why": "Present continuous always needs be + verb-ing, not just be + verb."
    },
    {
      "wrong": "Mateo climbing the steps.",
      "right": "Mateo <b>is climbing</b> the steps.",
      "why": "You can't drop be — English needs it before the -ing verb."
    },
    {
      "wrong": "She is siting on the wall.",
      "right": "She is <b>sitting</b> on the wall.",
      "why": "Sit ends in one vowel + one consonant, so double the t: sitting."
    },
    {
      "wrong": "What you are doing?",
      "right": "What <b>are you doing</b>?",
      "why": "In a question, be jumps in front of the person, right after the question word."
    },
    {
      "wrong": "I'm liking this song a lot.",
      "right": "I <b>like</b> this song a lot.",
      "why": "Like describes a feeling, not an action, so it doesn't usually take -ing."
    }
  ],
  "l1": [
    {
      "es": "Estoy comiendo.",
      "wrong": "I eating.",
      "right": "I<b>'m eating</b>.",
      "why": "English always needs am/is/are before the -ing verb; Spanish estoy already includes it."
    },
    {
      "es": "Está lloviendo.",
      "wrong": "Is raining.",
      "right": "<b>It's raining</b>.",
      "why": "English sentences need a subject — use it for weather."
    },
    {
      "es": "Mateo está subiendo las escaleras.",
      "wrong": "Mateo is climb the steps.",
      "right": "Mateo <b>is climbing</b> the steps.",
      "why": "The verb after is needs the -ing ending, not the base form."
    },
    {
      "es": "¿Qué estás haciendo?",
      "wrong": "What you doing?",
      "right": "What <b>are you doing</b>?",
      "why": "Don't drop the helper verb are — it's needed in every present continuous question."
    },
    {
      "es": "Me gusta esta canción.",
      "wrong": "I'm liking this song.",
      "right": "I <b>like</b> this song.",
      "why": "Like describes a feeling (a state), so it stays in the present simple, not -ing."
    }
  ],
  "remember": {
    "trick": "Be + verb-ing = happening RIGHT NOW!",
    "tip": "Point at your watch when you say it: be + verb-ing means it's happening at this exact second."
  },
  "dialogue": {
    "title": "Photos from Cusco",
    "context": "The class is on a school trip to Cusco. Miss Vega checks in with Sofia as she looks around the main square.",
    "lines": [
      {
        "speaker": "Miss Vega",
        "text": "Sofia, where's Mateo? What <b>is</b> he <b>doing</b>?"
      },
      {
        "speaker": "Sofia",
        "text": "<b>He's climbing</b> the old steps over there!"
      },
      {
        "speaker": "Miss Vega",
        "text": "Careful, Mateo! And where are Liam and Nadia?"
      },
      {
        "speaker": "Sofia",
        "text": "<b>They're eating</b> ice cream near the square."
      },
      {
        "speaker": "Miss Vega",
        "text": "<b>Is</b> Nadia <b>taking</b> photos too?"
      },
      {
        "speaker": "Sofia",
        "text": "Yes, she <b>is</b>. She<b>'s</b> always <b>taking</b> photos!"
      },
      {
        "speaker": "Miss Vega",
        "text": "Great. What about you? What <b>are</b> you <b>doing</b>?"
      },
      {
        "speaker": "Sofia",
        "text": "<b>I'm writing</b> a postcard for my parents."
      },
      {
        "speaker": "Miss Vega",
        "text": "Lovely. Don't forget to look at the mountains too!"
      }
    ]
  },
