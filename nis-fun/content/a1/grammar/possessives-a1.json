      ],
      "caption": "A possessive word always sits right before the noun it owns. <i>Whose</i> asks the question; <b>'s</b> or <b>his/her/its</b> gives the answer."
    },
    {
      "type": "map",
      "title": "Which possessive word?",
      "center": "possessive adjectives",
      "branches": [
        {
          "label": "I → my",
          "items": [
            "my bag"
          ],
          "tone": "a"
        },
        {
          "label": "you → your",
          "items": [
            "your book"
          ],
          "tone": "a"
        },
        {
          "label": "he → his · she → her · it → its",
          "items": [
            "his bike",
            "her bag",
            "its tail"
          ],
          "tone": "b"
        },
        {
          "label": "we → our · they → their",
          "items": [
            "our class",
            "their school"
          ],
          "tone": "c"
        }
      ]
    },
    {
      "type": "spelling",
      "title": "The apostrophe s",
      "rules": [
        {
          "rule": "One owner: name + 's",
          "examples": [
            "Sofia → Sofia<b>'s</b> bag",
            "Mateo → Mateo<b>'s</b> book"
          ]
        },
        {
          "rule": "Plural owners ending in -s: just add '",
          "examples": [
            "my parents → my parents<b>'</b> car",
            "the girls → the girls<b>'</b> classroom"
          ]
        },
        {
          "rule": "Plural owners NOT ending in -s: + 's",
          "examples": [
            "the children → the children<b>'s</b> toys",
            "the men → the men<b>'s</b> team"
          ]
        }
      ],
      "caption": "One owner, one name: add 's. More than one owner already ending in -s: just add the apostrophe."
    }
  ],
