  "use": [
    {
      "point": "Possessive adjectives: whose it is",
      "examples": [
        {
          "text": "This is <b>my</b> pencil case.",
          "note": "my = belongs to me"
        },
        {
          "text": "Is that <b>your</b> jacket?",
          "note": "your = belongs to you"
        },
        {
          "text": "Mateo is with <b>his</b> dog.",
          "note": "his = belongs to a boy or man"
        },
        {
          "text": "Nadia is with <b>her</b> cat.",
          "note": "her = belongs to a girl or woman"
        }
      ]
    },
    {
      "point": "its, our and their",
      "examples": [
        {
          "text": "The dog is wagging <b>its</b> tail.",
          "note": "its = belongs to an animal or a thing"
        },
        {
          "text": "This is <b>our</b> classroom.",
          "note": "our = belongs to us"
        },
        {
          "text": "That's <b>their</b> football.",
          "note": "their = belongs to them"
        }
      ]
    },
    {
      "point": "The apostrophe s: name + 's",
      "examples": [
        {
          "text": "That's <b>Sofia's</b> bag.",
          "note": "one owner → name + 's"
        },
        {
          "text": "<b>My parents'</b> car is red.",
          "note": "plural owners ending in -s → just add '"
        },
        {
          "text": "The <b>children's</b> toys are on the floor.",
          "note": "plural not ending in -s → + 's"
        }
      ]
    },
    {
      "point": "Whose…? and object pronouns",
      "examples": [
        {
          "text": "<b>Whose</b> is this pen? — It's Liam's.",
          "note": "whose asks about the owner"
        },
        {
          "text": "Can you help <b>me</b>?",
          "note": "object pronoun after the verb"
        },
        {
          "text": "Miss Vega is looking at <b>them</b>.",
          "note": "object pronoun after the verb: them"
        },
        {
          "text": "This present is for <b>her</b>.",
          "note": "object pronoun after a preposition: for her"
        }
      ]
    }
  ],
  "watch_out": [
    {
      "wrong": "This is the bag of Sofia.",
      "right": "This is <b>Sofia's</b> bag.",
      "why": "English usually shows ownership with 's after a name, not with of."
    },
    {
      "wrong": "He is with his' dog.",
      "right": "He is with <b>his</b> dog.",
      "why": "His never takes an apostrophe — it's already a full possessive word."
    },
    {
      "wrong": "The car has broken his lights.",
      "right": "The car has broken <b>its</b> lights.",
      "why": "Things use its, not his or her."
    },
    {
      "wrong": "Is this you bag?",
      "right": "Is this <b>your</b> bag?",
      "why": "Don't confuse you (the person) with your (the possessive word)."
    },
    {
      "wrong": "The childrens' toys are here.",
      "right": "The <b>children's</b> toys are here.",
      "why": "Children is already plural, so just add 's — not s'."
    },
    {
      "wrong": "Give the book to I.",
      "right": "Give the book to <b>me</b>.",
      "why": "After a preposition or a verb, use the object pronoun me, not I."
    }
  ],
  "l1": [
    {
      "es": "Su perro es grande.",
      "wrong": "Su dog is big.",
      "right": "<b>His</b> dog is big. / <b>Her</b> dog is big.",
      "why": "Spanish su can mean his, her, its or their — English needs a different word for each owner."
    },
    {
      "es": "El coche de mi papá.",
      "wrong": "The car of my dad.",
      "right": "My dad<b>'s</b> car.",
      "why": "English usually shows ownership with 's after the owner, not with of."
    },
    {
      "es": "Dame el libro a mí.",
      "wrong": "Give the book to I.",
      "right": "Give the book to <b>me</b>.",
      "why": "After to, for or a verb, English needs the object form: me, not I."
    },
    {
      "es": "Los juguetes de los niños.",
      "wrong": "The toys of the childrens.",
      "right": "The <b>children's</b> toys.",
      "why": "Children is already plural — don't add another -s, and use 's, not of."
    },
    {
      "es": "¿De quién es esto?",
      "wrong": "Who is this bag?",
      "right": "<b>Whose</b> is this bag?",
      "why": "Who asks about a person; whose asks about an owner — they look similar but mean different things."
    }
  ],
  "remember": {
    "trick": "MY YOUR HIS HER ITS OUR THEIR — before the noun!",
    "tip": "A possessive word always comes right before the noun it owns: my bag, her cat, their house. It never stands alone."
  },
  "dialogue": {
    "title": "Whose present is this?",
    "context": "It's Sofia's birthday party at her house in Lima, and the presents on the table are all mixed up.",
    "lines": [
      {
        "speaker": "Nadia",
        "text": "<b>Whose</b> present is this, Liam?"
      },
      {
        "speaker": "Liam",
        "text": "That's not mine — I think it's <b>Mateo's</b>."
      },
      {
        "speaker": "Mateo",
        "text": "Yes, that's <b>my</b> present! Where's <b>your</b> present, Nadia?"
      },
      {
        "speaker": "Nadia",
        "text": "<b>My</b> present is the small red one."
      },
      {
        "speaker": "Sofia",
        "text": "Thank you! I love <b>your</b> presents, everyone."
      },
      {
        "speaker": "Liam",
        "text": "<b>Whose</b> is the big blue box?"
      },
      {
        "speaker": "Mateo",
        "text": "That's Miss Vega<b>'s</b> present for Sofia."
      },
      {
        "speaker": "Nadia",
        "text": "Look at <b>its</b> ribbon — it's huge!"
      },
      {
        "speaker": "Sofia",
        "text": "I can't wait to open <b>them</b> all!"
      },
      {
        "speaker": "Liam",
        "text": "Open this one first — it's from <b>us</b>!"
      }
    ]
  },
