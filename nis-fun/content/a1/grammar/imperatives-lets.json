          "note": "two instructions joined with and"
        },
        {
          "text": "<b>Turn</b> left at the market.",
          "note": "giving directions"
        }
      ]
    },
    {
      "point": "Negative imperatives — Don't",
      "examples": [
        {
          "text": "<b>Don't run</b> in the corridor.",
          "note": "don't + base verb"
        },
        {
          "text": "<b>Don't forget</b> your homework.",
          "note": "a reminder"
        },
        {
          "text": "<b>Don't touch</b> the paint — it's wet.",
          "note": "a warning"
        }
      ]
    },
    {
      "point": "Let's — suggestions for you and me",
      "examples": [
        {
          "text": "<b>Let's</b> make a cake for the party.",
          "note": "let's = let us, a suggestion"
        },
        {
          "text": "<b>Let's</b> play a game before lunch.",
          "note": "an idea for the group"
        },
        {
          "text": "<b>Let's not</b> be late for the bus.",
          "note": "negative suggestion"
        }
      ]
    },
    {
      "point": "Please and signs",
      "examples": [
        {
          "text": "<b>Please</b> wait here.",
          "note": "please makes an instruction more polite"
        },
        {
          "text": "<b>Close</b> the gate, <b>please</b>.",
          "note": "please can go at the start or the end"
        },
        {
          "text": "<b>Mix</b> the eggs and sugar together.",
          "note": "recipe instructions are imperatives too"
        }
      ]
    }
  ],
  "watch_out": [
    {
      "wrong": "You open your book.",
      "right": "<b>Open</b> your book.",
      "why": "An imperative has no subject — start straight with the verb."
    },
    {
      "wrong": "Not run in the corridor.",
      "right": "<b>Don't run</b> in the corridor.",
      "why": "The negative imperative needs Don't, not just Not."
    },
    {
      "wrong": "Let's to play football.",
      "right": "<b>Let's play</b> football.",
      "why": "No to after Let's — use the base verb."
    },
    {
      "wrong": "Lets play a game.",
      "right": "<b>Let's</b> play a game.",
      "why": "Let's is short for let us — don't forget the apostrophe."
    },
    {
      "wrong": "Don't runs in the hall.",
      "right": "<b>Don't run</b> in the hall.",
      "why": "The base verb never takes -s after don't."
    },
    {
      "wrong": "Let's don't be late.",
      "right": "<b>Let's not</b> be late.",
      "why": "The negative of Let's is Let's not, never Let's don't."
    }
  ],
  "l1": [
    {
      "es": "Abre tu libro.",
      "wrong": "You open your book.",
      "right": "<b>Open</b> your book.",
      "why": "Spanish can use a subject for a command, but English imperatives drop it completely."
    },
    {
      "es": "No corras.",
      "wrong": "Not run.",
      "right": "<b>Don't run</b>.",
      "why": "The negative imperative always starts with don't, not just not."
    },
    {
      "es": "Vamos a jugar.",
      "wrong": "Let's to play.",
      "right": "<b>Let's play</b>.",
      "why": "Let's is already the suggestion — no extra to before the verb."
    },
    {
      "es": "No corramos.",
      "wrong": "Let's don't run.",
      "right": "<b>Let's not</b> run.",
      "why": "The negative of let's puts not straight after let's, with no don't."
    },
    {
      "es": "Por favor, cierra la puerta.",
      "wrong": "Please you close the door.",
      "right": "<b>Close</b> the door, please.",
      "why": "Please doesn't need a subject before the verb — the imperative already has none."
    }
  ],
  "remember": {
    "trick": "No subject, just the verb — Open! Don't run! Let's go!",
    "tip": "Imperatives jump straight to the verb — no I, you or she in front. Let's is the only one that means 'you and me together'."
  },
  "dialogue": {
    "title": "Planning Mateo's party",
    "context": "It's the day before Mateo's birthday. Sofia, Liam and Nadia are planning games and a cake at Sofia's house.",
    "lines": [
      {
        "speaker": "Sofia",
        "text": "<b>Let's</b> make a chocolate cake for tomorrow!"
      },
      {
        "speaker": "Nadia",
        "text": "Good idea! <b>Open</b> the flour first."
      },
      {
        "speaker": "Liam",
        "text": "<b>Don't forget</b> the sugar — Mateo loves sweet things."
      },
      {
        "speaker": "Sofia",
        "text": "OK. <b>Let's not</b> put too much chocolate, though."
      },
      {
        "speaker": "Nadia",
        "text": "Why not?"
      },
      {
        "speaker": "Sofia",
        "text": "<b>Don't tell</b> Mateo, but Miss Vega is coming too, and she doesn't like it too sweet!"
      },
      {
        "speaker": "Liam",
        "text": "Ha! OK. <b>Let's</b> also plan a game for the party."
      },
      {
        "speaker": "Nadia",
        "text": "<b>Mix</b> the eggs now, Liam, please."
      },
      {
        "speaker": "Liam",
        "text": "On it! <b>Let's</b> finish before six o'clock."
      }
    ]
  },
