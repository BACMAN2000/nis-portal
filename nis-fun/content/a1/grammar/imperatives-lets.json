    {
      "type": "steps",
      "title": "How to make a negative imperative",
      "steps": [
        {
          "label": "Start with Don't",
          "ex": "<b>Don't</b>"
        },
        {
          "label": "Add the base verb",
          "ex": "Don't <b>run</b>"
        },
        {
          "label": "Add the rest",
          "ex": "Don't run <b>in the corridor</b>."
        }
      ],
      "caption": "Don't + base verb — no to, no -s, just like an ordinary imperative."
    }
  ],
