    {
      "type": "steps",
      "title": "How to ask permission politely",
      "steps": [
        {
          "label": "Start with Can",
          "ex": "<b>Can</b>"
        },
        {
          "label": "Add I or a name",
          "ex": "Can <b>I</b>"
        },
        {
          "label": "Add the base verb — no to, no -s",
          "ex": "Can I <b>go</b> to the toilet?"
        }
      ],
      "caption": "Can + base verb, always. Never <i>can to go</i>, never <i>she cans</i>."
    }
  ],
