  "can_do": [
    "I can say what I can and can't do.",
    "I can ask <i>Can I…?</i> for permission and <i>Can you…?</i> to ask someone for help.",
    "I can answer with short answers: <i>Yes, I can. / No, I can't.</i>"
  ],
  "summary": [
    "<b>Can</b> never changes: no -s, no <i>to</i>, same for every person.",
    "Use <i>can</i> for ability, <i>Can I…?</i> for permission and <i>Can you…?</i> for polite requests.",
    "Negative: <b>can't</b> (or <i>cannot</i>) + base verb.",
    "Question: <i>can</i> jumps to the front — no <i>do/does</i> needed.",
    "Short answer: <i>Yes, I can. / No, I can't.</i> — say can't clearly so people hear the difference."
  ]
}
