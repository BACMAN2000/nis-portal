  "use": [
    {
      "point": "Ability — what you can and can't do",
      "examples": [
        {
          "text": "I <b>can</b> swim, but I <b>can't</b> dive.",
          "note": "two abilities, one good, one not"
        },
        {
          "text": "Nadia <b>can</b> play the guitar.",
          "note": "she has the skill"
        },
        {
          "text": "Penguins <b>can't</b> fly, but they <b>can</b> swim.",
          "note": "can/can't for animals too"
        }
      ]
    },
    {
      "point": "Asking for and giving permission",
      "examples": [
        {
          "text": "<b>Can I</b> go to the toilet, please?",
          "note": "asking the teacher for permission"
        },
        {
          "text": "<b>Can I</b> borrow your pen?",
          "note": "asking to use something"
        },
        {
          "text": "You <b>can</b> sit here if you like.",
          "note": "giving permission"
        }
      ]
    },
    {
      "point": "Polite requests — asking someone else to do something",
      "examples": [
        {
          "text": "<b>Can you</b> help me with this exercise?",
          "note": "a polite request for help"
        },
        {
          "text": "<b>Can you</b> pass the ball, please?",
          "note": "asking someone to do something"
        }
      ]
    },
    {
      "point": "Possibility and short answers",
      "examples": [
        {
          "text": "It <b>can</b> be very cold in Cusco at night.",
          "note": "can for something that is sometimes true"
        },
        {
          "text": "<b>Can</b> you swim? — Yes, I <b>can</b>. / No, I <b>can't</b>.",
          "note": "short answer = person + can/can't"
        },
        {
          "text": "Anyone <b>can</b> make a mistake.",
          "note": "can for general possibility"
        }
      ]
    }
  ],
  "watch_out": [
    {
      "wrong": "I can to swim.",
      "right": "I <b>can</b> swim.",
      "why": "Can is followed by the base verb — never to."
    },
    {
      "wrong": "She cans swim.",
      "right": "She <b>can</b> swim.",
      "why": "Can never adds -s, even for he/she/it."
    },
    {
      "wrong": "I can swimming.",
      "right": "I <b>can</b> swim.",
      "why": "After can, use the base verb, not the -ing form."
    },
    {
      "wrong": "You can to use my pen.",
      "right": "You can <b>use</b> my pen.",
      "why": "No to after can, in statements or offers."
    },
    {
      "wrong": "Do you can swim?",
      "right": "<b>Can you</b> swim?",
      "why": "Can makes its own question by moving to the front — no do/does needed."
    },
    {
      "wrong": "Yes, I can swim.",
      "right": "Yes, I <b>can</b>.",
      "why": "A short answer repeats only the person + can/can't, not the whole verb again."
    }
  ],
  "l1": [
    {
      "es": "Puedo nadar.",
      "wrong": "I can to swim.",
      "right": "I <b>can</b> swim.",
      "why": "Spanish poder + infinitive (nadar) becomes can + base verb in English, with no to."
    },
    {
      "es": "¿Puedes ayudarme?",
      "wrong": "Can you to help me?",
      "right": "<b>Can you help</b> me?",
      "why": "No to after can, even in a question."
    },
    {
      "es": "Ella puede tocar guitarra.",
      "wrong": "She cans play guitar.",
      "right": "She <b>can</b> play the guitar.",
      "why": "Can never takes an -s, not even for he/she/it."
    },
    {
      "es": "¿Puedo entrar?",
      "wrong": "I can enter?",
      "right": "<b>Can I</b> come in?",
      "why": "For a question, can moves to the front of the sentence, before the person."
    },
    {
      "es": "No puedo correr rápido.",
      "wrong": "I no can run fast.",
      "right": "I <b>can't</b> run fast.",
      "why": "The negative of can is can't (or cannot) — don't use no with a verb."
    }
  ],
  "remember": {
    "trick": "Can + verb, never can + to!",
    "tip": "Say can quickly in a sentence, but say can't clearly and stop — CAN'T — so people hear the difference."
  },
  "dialogue": {
    "title": "Sports day",
    "context": "It's sports day at Nordic. Miss Vega is choosing students for different events.",
    "lines": [
      {
        "speaker": "Miss Vega",
        "text": "OK, everyone! <b>Can</b> you swim, Liam?"
      },
      {
        "speaker": "Liam",
        "text": "Yes, I <b>can</b>, but I <b>can't</b> run very fast."
      },
      {
        "speaker": "Miss Vega",
        "text": "No problem. <b>Can you</b> try the long jump instead?"
      },
      {
        "speaker": "Liam",
        "text": "Sure! <b>Can I</b> practise first?"
      },
      {
        "speaker": "Miss Vega",
        "text": "Of course. Mateo, <b>can</b> you play football well?"
      },
      {
        "speaker": "Mateo",
        "text": "Yes, I <b>can</b>! I <b>can't</b> play basketball, though — I'm too short!"
      },
      {
        "speaker": "Miss Vega",
        "text": "Ha! Nadia, <b>can</b> you help with the race times?"
      },
      {
        "speaker": "Nadia",
        "text": "Yes, I <b>can</b> — I'm good at maths."
      }
    ]
  },
